VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Required for cloud auth/session token verification outside local demos.
SESSION_SECRET=replace-with-a-long-random-secret

# Builds are offline/deterministic by default. Set true only for intentional feed refresh jobs.
SYNC_REMOTE_ON_BUILD=false

# Raw HTML proxy is disabled by default and allowlisted when enabled.
ALLOW_RAW_HTML_FETCH=false

# Local JSON storage is for dev/test only. Production should use durable storage.
ALLOW_LOCAL_JSON_STORAGE=false
KV_REST_API_URL=
KV_REST_API_TOKEN=
POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=

# Optional refresh secrets for scheduled/admin feed refresh endpoints.
NEWS_REFRESH_SECRET=
YOUTUBE_REFRESH_SECRET=

# Optional upstream API keys.
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
